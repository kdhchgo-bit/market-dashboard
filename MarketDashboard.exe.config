<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="SpreadMax" value="0.15" />
    <add key="BarStaleMin" value="10" />
    <add key="UsChainMaxAgeMin" value="35" />
    <add key="CoinChainMaxAgeMin" value="25" />
    <add key="VolLookback" value="20" />
    <add key="VolMinSamples" value="20" />
    <add key="VolMultMin" value="1" />
    <add key="EventBeforeMin" value="30" />
    <add key="EventAfterMin" value="15" />
    <add key="NewsWindowMin" value="60" />
    <add key="UsoPct" value="0.95" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <AppContextSwitchOverrides value="Switch.System.Windows.DoNotScaleForDpiChanges=false" />
  </runtime>
</configuration>
